# Okta Org (base URL used for both the token endpoint and the Users API)
OKTA_DOMAIN=https://your-domain.okta.com
OKTA_ISSUER=https://your-domain.okta.com

# Agent Configuration (Outbound) - reuse the same agent identity as the webapp
# This is "Agent A" in the A2A chain below: the front door that receives the
# caller's raw ID token and initiates delegation to Agent B.
AGENT_CLIENT_ID=your-agent-client-id
AGENT_PRIVATE_KEY_PATH=../agent-keys/agent-private-key.json

# Agent B - second AI Agent identity in the A2A chain. Agent A delegates to
# it via two chained ID-JAG hops; Agent B is the one that ultimately performs
# the PAM exchange below, so the resulting access token's `act` claim names
# Agent A as the actor who invoked it. Requires: Agent B registered +
# activated as an AI Agent, a delegation link Agent A -> Agent B, and a
# managed connection (IDENTITY_ASSERTION_A2A_SERVER) from Agent A to Agent B's
# Custom AS.
AGENT_B_CLIENT_ID=your-second-agent-client-id
AGENT_B_PRIVATE_KEY_PATH=../agent-keys/agent-b-private-key.json
# Agent B's registered resourceUrl (workload-principals/api/v1/ai-agents) -
# used as the `resource` param when Agent A requests the ID-JAG for Agent B.
AGENT_B_RESOURCE_URL=
# Custom Authorization Server id fronting Agent B (the one linked to it via
# resource-servers/api/v1/a2a-servers/{agentBId}/authorization-servers) -
# used to build the audience for hop 1 and the token endpoint for hop 1's
# jwt-bearer redemption.
AGENT_B_AUTH_SERVER_ID=
# Scope granted by Agent B's Custom AS policy for client_credentials + jwt-bearer.
AGENT_B_SCOPE=agent.invoke

# ORN of the PAM managed connection holding the Okta API token (vaulted secret)
VAULTED_SECRET_RESOURCE_ORN=orn:oktapreview:pam:xxxxxxxxxxxx:secrets:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ORN of the PAM-managed Salesforce service account (O4AA service-account exchange)
SERVICE_ACCOUNT_RESOURCE_ORN=orn:oktapreview:pam:xxxxxxxxxxxx:apps:salesforce:xxxxxxxxxxxxxxxxxxxx:service_accounts:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Optional - only needed if you want get_salesforce_service_account to actually
# log into Salesforce with the retrieved service-account credential (a
# Salesforce Connected App). Skipped gracefully if left unset.
SALESFORCE_LOGIN_URL=https://login.salesforce.com
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=

# HTTP server port
HTTP_PORT=8081

LOG_LEVEL=info
