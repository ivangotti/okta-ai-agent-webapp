{
  "name": "nist-csf-chatbot",
  "version": "1.0.0",
  "description": "Web chatbot for NIST CSF 2.0 with MCP integration",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "start:mcp": "cd mcp-server && npm run start:http",
    "start:both": "concurrently \"npm run start:mcp\" \"npm start\"",
    "setup:mcp": "cd mcp-server && npm install && npm run build && npm run import:csf-framework && npm run seed:questions",
    "setup:all": "npm install && npm run setup:mcp"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "passport": "^0.7.0",
    "passport-openidconnect": "^0.1.2"
  }
}
