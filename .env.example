# LiteLLM Configuration
ANTHROPIC_BASE_URL=https://llm.atko.ai
LITELLM_KEY=your-litellm-api-key-here
ANTHROPIC_DEFAULT_SONNET_MODEL=claude-4-5-sonnet
MODEL=claude-4-5-sonnet

# MCP Server
MCP_SERVER_URL=http://localhost:8080

# Webapp Server
PORT=3001

# Okta User Authentication (Inbound)
OKTA_DOMAIN=https://your-domain.okta.com
OKTA_ISSUER=https://your-domain.okta.com/oauth2/default
OKTA_CLIENT_ID=your-webapp-client-id
OKTA_CLIENT_SECRET=your-webapp-client-secret
OKTA_REDIRECT_URI=http://localhost:3001/authorization-code/callback
OKTA_LOGOUT_REDIRECT_URI=http://localhost:3001

# Agent Configuration (Outbound)
AGENT_CLIENT_ID=your-agent-client-id
AGENT_NAME=NIST CSF 2.0 AI Agent
CUSTOM_AUTH_SERVER=https://your-domain.okta.com/oauth2/your-custom-server-id

# Agent Private Key Path
AGENT_PRIVATE_KEY_PATH=./agent-keys/agent-private-key.json

# Session Secret (change in production!)
SESSION_SECRET=change-this-to-a-random-string-in-production
